# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGNING_SECRET=

# Clerk Redirect URLs (optional - defaults)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# NeonDB (PostgreSQL)
DATABASE_URL=""

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_STUDIO_TOKEN=

# Paystack
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Resend (booking/cancellation emails and contact form)
RESEND_API_KEY=
CONTACT_EMAIL=bookings@yourdomain.com
NEXT_PUBLIC_CONTACT_EMAIL=bookings@yourdomain.com

# Sentry (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING=1

# Admin portal (independent cookie auth)
# REQUIRED in production. Do not use these development placeholders in a deployment.
# Generate ADMIN_SECRET with: openssl rand -hex 32
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SECRET=

# Next.js
NEXT_PUBLIC_URL=http://localhost:3000
